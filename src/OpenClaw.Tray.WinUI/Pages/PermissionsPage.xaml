<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="OpenClawTray.Pages.PermissionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:helpers="using:OpenClawTray.Helpers"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Page.Resources>
        <Thickness x:Key="PermSectionHeaderMargin">4,18,4,4</Thickness>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="8" HorizontalAlignment="Stretch" MaxWidth="900">

            <!-- ───────── Page header ───────── -->
            <TextBlock x:Uid="PermissionsPage_Permissions" Text="Permissions"
                       AutomationProperties.AutomationId="PermissionsPageMarker"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,2">
                <FontIcon Glyph="&#xE977;" FontSize="14" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="HostnameText"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Uid="PermissionsPage_IntroText"
                       Text="Capabilities this PC offers to agents through the gateway, plus what each agent is allowed to do once connected."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>

            <!-- ═════════ Node Mode + Node Status ═════════ -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="16"
                    AutomationProperties.AutomationId="NodeStatusCard">
                <StackPanel Spacing="12">
                    <!-- Node Mode master toggle row -->
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE839;" FontSize="22"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Uid="PermissionsPage_NodeMode" Text="Node mode"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="PermissionsPage_WhenOnThisPC" Text="When on, this PC registers as a node and offers the capabilities below to agents over the gateway."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" x:Name="NodeModeToggle"
                                      MinWidth="0" OnContent="" OffContent=""
                                      Toggled="OnNodeModeToggled"
                                      AutomationProperties.AutomationId="CapabilitiesNodeModeToggle"
                                      AutomationProperties.Name="Node mode"/>
                    </Grid>

                    <!-- Subtle divider between master switch and status sub-row -->
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

                    <!-- Live status sub-row -->
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" x:Name="NodeStatusDot" Width="12" Height="12"
                                 Fill="Gray" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Uid="NodeStatusText" x:Name="NodeStatusText" Text="Node mode disabled"
                                       Style="{StaticResource BodyTextBlockStyle}"/>
                            <TextBlock x:Name="NodeDetailsText"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═════════ Capability features ═════════ -->
            <TextBlock x:Uid="PermissionsPage_Capabilities" x:Name="FeaturesSectionHeader" Text="Capabilities" Style="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="{StaticResource PermSectionHeaderMargin}"/>
            <TextBlock x:Uid="PermissionsPage_ToggleIndividualFeaturesThat" x:Name="FeaturesSectionDescription"
                       Text="Toggle individual features that agents may request from this PC."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" Margin="4,0,4,4"/>

            <!-- Capability rows are built in code-behind so each gets icon + name + description + toggle. -->
            <ItemsRepeater x:Name="CapabilityRepeater">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>

            <!-- ═════════ Voice settings link (only when STT or TTS capability is on) ═════════ -->
            <Border x:Name="VoiceSettingsCard" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,10,16,12" Margin="0,-4,0,0"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="PermissionsVoiceSettingsCard">
                <StackPanel Spacing="6">
                    <StackPanel x:Name="VoiceSettingsHelpPanel"
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="Collapsed">
                        <FontIcon x:Name="VoiceSettingsWarningIcon"
                                  Glyph="&#xE7BA;"
                                  FontSize="14"
                                  Margin="0,1,0,0"
                                  VerticalAlignment="Top"
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                  AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock x:Name="VoiceSettingsHelpText"
                                   Text=""
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <HyperlinkButton x:Name="VoiceSettingsLink"
                                     x:Uid="PermissionsPage_VoiceSettingsLink"
                                     Content="Voice &amp; Audio settings"
                                     Click="OnVoiceSettingsClick"
                                     Padding="0"/>
                </StackPanel>
            </Border>

            <!-- ═════════ Integrations ═════════ -->
            <TextBlock x:Uid="PermissionsPage_Integrations" Text="Integrations" Style="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="{StaticResource PermSectionHeaderMargin}"/>

            <Border x:Name="McpCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE968;" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Uid="PermissionsPage_McpHeader" Text="Local MCP Server"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="PermissionsPage_McpDescription"
                                       Text="Serves capabilities to local MCP clients (CLI tools, integrations) on this PC over HTTP."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" x:Name="McpToggle" MinWidth="0" OnContent="" OffContent=""
                                      Toggled="OnMcpToggled"
                                      AutomationProperties.Name="Local MCP Server"/>
                    </Grid>
                    <StackPanel x:Name="McpDetailsPanel" Spacing="8" Visibility="Collapsed" Margin="50,0,0,0">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="PermissionsPage_McpEndpointLabel" Grid.Column="0" Text="Endpoint:" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="McpEndpointText" Grid.Column="1" IsTextSelectionEnabled="True"
                                       VerticalAlignment="Center" FontFamily="Consolas"
                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="CopyMcpTokenButton" x:Name="CopyMcpTokenButton" Content="Copy token" Click="OnCopyMcpToken"/>
                            <Button x:Uid="CopyMcpUrlButton" x:Name="CopyMcpUrlButton" Content="Copy URL" Click="OnCopyMcpUrl"/>
                        </StackPanel>
                        <TextBlock x:Name="McpStatusText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═════════ Exec approvals V2 ═════════ -->
            <TextBlock x:Uid="PermissionsPage_ExecApprovalsHeader" Text="Exec approvals" Style="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="{StaticResource PermSectionHeaderMargin}"/>
            <TextBlock x:Uid="PermissionsPage_ExecApprovalsDescription"
                       Text="Control command access, prompting, and executable-path allowlists for defaults or a specific agent."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Margin="4,0,4,4"/>

            <controls:InfoBar x:Name="ExecPolicyStatusInfoBar"
                              IsOpen="False"
                              IsClosable="True"
                              Severity="Error"
                              AutomationProperties.AutomationId="ExecPolicyStatusInfoBar"
                              Margin="0,0,0,4"/>

            <toolkit:SettingsCard x:Uid="PermissionsPage_ExecPolicyScopeCard"
                                  Header="Policy scope"
                                  Description="Defaults apply to every agent. All agents and agent-specific scopes can override them.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="{x:Bind helpers:FluentIconCatalog.People, Mode=OneTime}"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ExecPolicyScopeCombo"
                          MinWidth="220"
                          DisplayMemberPath="Label"
                          SelectionChanged="OnExecPolicyScopeChanged"
                          AutomationProperties.AutomationId="ExecPolicyScopeCombo"/>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard x:Uid="PermissionsPage_ExecSecurityCard"
                                  Header="Command access"
                                  Description="Deny commands, allow only listed executables, or always allow commands in this scope.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="{x:Bind helpers:FluentIconCatalog.Lock, Mode=OneTime}"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ExecSecurityCombo"
                          MinWidth="220"
                          DisplayMemberPath="Label"
                          SelectionChanged="OnExecSecurityChanged"
                          AutomationProperties.AutomationId="ExecSecurityCombo"/>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard x:Uid="PermissionsPage_ExecAskCard"
                                  Header="Prompt behavior"
                                  Description="Choose when OpenClaw asks before running a command.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="{x:Bind helpers:FluentIconCatalog.Terminal, Mode=OneTime}"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ExecAskCombo"
                          MinWidth="220"
                          DisplayMemberPath="Label"
                          SelectionChanged="OnExecAskChanged"
                          AutomationProperties.AutomationId="ExecAskCombo"/>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard x:Uid="PermissionsPage_ExecFallbackCard"
                                  Header="Fallback when prompting is unavailable"
                                  Description="Applied when the node cannot show an approval prompt. Deny is the safest choice.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="{x:Bind helpers:FluentIconCatalog.Settings, Mode=OneTime}"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ExecFallbackCombo"
                          MinWidth="220"
                          DisplayMemberPath="Label"
                          SelectionChanged="OnExecFallbackChanged"
                          AutomationProperties.AutomationId="ExecFallbackCombo"/>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard x:Uid="PermissionsPage_ExecAutoAllowSkillsCard"
                                  Header="Allow trusted skill executables"
                                  Description="Allow executables declared by trusted skills without adding each path manually.">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="{x:Bind helpers:FluentIconCatalog.Check, Mode=OneTime}"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ExecAutoAllowSkillsCombo"
                          MinWidth="220"
                          DisplayMemberPath="Label"
                          SelectionChanged="OnExecAutoAllowSkillsChanged"
                          AutomationProperties.AutomationId="ExecAutoAllowSkillsCombo"/>
            </toolkit:SettingsCard>

            <toolkit:SettingsExpander x:Uid="PermissionsPage_ExecAllowlistExpander"
                                      x:Name="ExecAllowlistExpander"
                                      Header="Allowed executables"
                                      Description="Allowlist patterns match resolved executable paths. Use a path separator and wildcards such as **/git.exe."
                                      IsExpanded="True">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="{x:Bind helpers:FluentIconCatalog.Terminal, Mode=OneTime}"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Content>
                    <TextBlock x:Name="ExecAllowlistCountText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </toolkit:SettingsExpander.Content>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard x:Uid="PermissionsPage_ExecAllowlistDefaultsInfo"
                                          x:Name="ExecAllowlistDefaultsInfo"
                                          Header="Select an agent scope to edit allowlist entries"
                                          Description="Defaults configure policy behavior. Allowlist entries belong to All agents or a specific agent."/>
                    <toolkit:SettingsCard x:Uid="PermissionsPage_ExecAllowlistEmpty"
                                          x:Name="ExecAllowlistEmptyCard"
                                          Header="No allowed executables"
                                          Description="Commands that require approval will follow the prompt behavior above."/>
                    <toolkit:SettingsCard x:Uid="PermissionsPage_ExecAllowlistRulesCard"
                                          x:Name="ExecAllowlistRulesCard"
                                          Header="Allowed paths"
                                          Description="Each entry allows the resolved executable path for this scope.">
                        <ItemsRepeater x:Name="ExecAllowlistRepeater">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="240"
                                          Padding="0,4"
                                          ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Pattern}"
                                                       FontFamily="Consolas"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Details}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Click="OnRemoveExecAllowlistEntry"
                                                Tag="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="8"
                                                AutomationProperties.Name="{Binding RemoveAutomationName}"
                                                AutomationProperties.AutomationId="{Binding RemoveAutomationId}">
                                            <FontIcon Glyph="{Binding RemoveGlyph}"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard x:Uid="PermissionsPage_ExecAllowlistAddCard"
                                          x:Name="ExecAllowlistAddCard"
                                          Header="Add allowed executable"
                                          Description="Enter an executable path glob. Command-text patterns such as hostname or Get-* are not valid V2 rules.">
                        <Grid Width="240" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewExecAllowlistPattern"
                                         PlaceholderText="**/git.exe"
                                         FontFamily="Consolas"
                                         AutomationProperties.AutomationId="NewExecAllowlistPattern"/>
                                <Button Grid.Column="1"
                                        x:Uid="PermissionsPage_AddExecAllowlistButton"
                                        Content="Add"
                                        Click="OnAddExecAllowlistEntry"
                                        AutomationProperties.AutomationId="AddExecAllowlistButton"/>
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       x:Name="ExecAllowlistValidationText"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="ExecAllowlistValidationText"
                                       AutomationProperties.LiveSetting="Assertive"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <!-- ═════════ Node Allowlist (gateway-side, read-only) ═════════ -->
            <TextBlock x:Uid="PermissionsPage_TextBlock_69" Text="Node allowlist" Style="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="{StaticResource PermSectionHeaderMargin}"/>
            <TextBlock x:Uid="PermissionsPage_TextBlock_72"
                       Text="Commands the gateway will accept from connected nodes. Read-only: edit via the Config page."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Margin="4,0,4,4"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="AllowlistEmpty" x:Name="AllowlistEmpty"
                               Text="No allowlist data available. Connect to a gateway first."
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                    <ItemsRepeater x:Name="AllowlistRepeater">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4"/>
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- ═════════ Windows-level privacy ═════════ -->
            <TextBlock x:Uid="PermissionsPage_WindowsPrivacy" Text="Windows privacy" Style="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="{StaticResource PermSectionHeaderMargin}"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14,16,14">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Uid="PermissionsPage_CameraMicrophoneAmpScreen" Text="Camera, microphone &amp; screen access" Style="{StaticResource BodyTextBlockStyle}"/>
                        <TextBlock x:Uid="PermissionsPage_SystemLevelPrivacyPermissions" Text="System-level privacy permissions are managed by Windows. Open Windows Privacy Settings to grant or revoke OpenClaw access."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Uid="PermissionsPage_Button_123" Content="Open Windows privacy settings" Click="OnOpenPrivacySettings"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
